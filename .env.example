# ===== 应用 =====
APP_NAME=TradeAI
APP_ENV=dev
DEBUG=true
HOST=127.0.0.1
PORT=8000
TIMEZONE=Asia/Shanghai

# ===== 数据库 =====
# SQLite 示例：sqlite:///./data/tradeai.db
# PostgreSQL 示例：postgresql+psycopg://user:pass@localhost:5432/tradeai
DATABASE_URL=sqlite:///./data/tradeai.db

# ===== 行情 =====
# tencent / sina
QUOTE_PRIMARY=tencent
QUOTE_TIMEOUT_SECONDS=8
QUOTE_CACHE_SECONDS=10
POLL_INTERVAL_SECONDS=120
# 全市场抓取：每批 400 只，6 个并发请求
QUOTE_BATCH_SIZE=400
QUOTE_WORKERS=6

# ===== 日线与发现 =====
BAR_BACKFILL_DAYS=320
BAR_INCREMENTAL_DAYS=12
BAR_FETCH_WORKERS=8
DISCOVERY_TOP_N=30

# ===== 监控与预警 =====
# 默认关闭，确认规则后再改成 true（启动后盘中每 120 秒轮询一次）
MONITOR_ENABLED=false
ALERT_CONFIRM_SAMPLES=2
ALERT_STOP_CONFIRM_SAMPLES=1
ALERT_COOLDOWN_SECONDS=1800
ALERT_REARM_PCT=0.5
ALERT_TRAILING_DRAWDOWN_PCT=8
ALERT_PRICE_CHANGE_PCT=5

# ===== DeepSeek =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60
AI_DAILY_BUDGET_CNY=5
# 元 / 百万 tokens，按 DeepSeek 实际价格调整
AI_INPUT_PRICE_CNY=2
AI_OUTPUT_PRICE_CNY=8
AI_PROMPT_VERSION=plan-v1
AI_REVIEW_PROMPT_VERSION=review-v1
AI_MAX_PLANS=10

# ===== 飞书 =====
FEISHU_WEBHOOK=

# ===== 邮件 =====
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_SSL=true

# ===== 功能开关 =====
# 持仓面板（成本/盈亏）：默认关闭
FEATURE_HOLDINGS=false
# AI 交易计划：回测显示当前候选期望为负，默认关闭，避免为正负期望信号付费
FEATURE_AI_PLANS=false

# ===== AI 提供方（二选一）=====
# 方式 A：DeepSeek 官方
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
#
# 方式 B：OpenCode Go（订阅制，OpenAI 兼容，模型 deepseek-v4.1-flash）
# key 在 OpenCode 控制台生成：https://opencode.ai/auth
# DEEPSEEK_API_KEY=sk-...（OpenCode 的 key）
# DEEPSEEK_BASE_URL=https://opencode.ai/zen/go/v1
# DEEPSEEK_MODEL=deepseek-v4.1-flash
# 若网关不支持 response_format=json_object，设为 false（仍会从正文解析 JSON）
# AI_JSON_MODE=true


