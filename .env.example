# ===== 应用 =====
APP_NAME=TradeAI
APP_ENV=dev
DEBUG=true
HOST=127.0.0.1
PORT=8000
TIMEZONE=Asia/Shanghai

# ===== 数据库（后续接入） =====
# SQLite 示例：sqlite:///./data/tradeai.db
# PostgreSQL 示例：postgresql+psycopg://user:pass@localhost:5432/tradeai
DATABASE_URL=sqlite:///./data/tradeai.db

# ===== 行情 =====
# tencent / sina
QUOTE_PRIMARY=tencent
QUOTE_TIMEOUT_SECONDS=8
QUOTE_CACHE_SECONDS=10
POLL_INTERVAL_SECONDS=120

# ===== DeepSeek =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_DAILY_BUDGET_CNY=5

# ===== 飞书 =====
FEISHU_WEBHOOK=

# ===== 邮件 =====
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_SSL=true
