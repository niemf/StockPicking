# ===== 应用 =====
APP_NAME=TradeAI
APP_ENV=dev
DEBUG=true
HOST=127.0.0.1
PORT=8000
TIMEZONE=Asia/Shanghai

# ===== 数据库 =====
# SQLite 示例：sqlite:///./data/tradeai.db
# PostgreSQL 示例：postgresql+psycopg://user:pass@localhost:5432/tradeai
DATABASE_URL=sqlite:///./data/tradeai.db

# ===== 行情 =====
# tencent / sina
QUOTE_PRIMARY=tencent
QUOTE_TIMEOUT_SECONDS=8
QUOTE_CACHE_SECONDS=10
POLL_INTERVAL_SECONDS=120

# ===== 监控与预警 =====
# 默认关闭，确认规则后再改成 true（启动后盘中每 120 秒轮询一次）
MONITOR_ENABLED=false
ALERT_CONFIRM_SAMPLES=2
ALERT_STOP_CONFIRM_SAMPLES=1
ALERT_COOLDOWN_SECONDS=1800
ALERT_REARM_PCT=0.5
ALERT_TRAILING_DRAWDOWN_PCT=8
ALERT_PRICE_CHANGE_PCT=5

# ===== DeepSeek =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_DAILY_BUDGET_CNY=5

# ===== 飞书 =====
FEISHU_WEBHOOK=

# ===== 邮件 =====
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_SSL=true
