# TradeAI production environment (Ubuntu server)
# Copy to /opt/tradeai/.env and fill in the secrets. Never commit this file.

APP_ENV=prod
DEBUG=false
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./data/tradeai.db

# Real-time monitoring loop inside the web process (watchlist + holdings)
MONITOR_ENABLED=true
POLL_INTERVAL_SECONDS=60

# Watchlist intraday signals (deterministic, no AI). Set false to mute a group.
ALERT_WATCH_STATS_ENABLED=true
ALERT_BREAKOUT_ENABLED=true
ALERT_INTRADAY_ENABLED=true
ALERT_BUY_SIGNAL_ENABLED=true
ALERT_PULLBACK_ENABLED=true

# DeepSeek (AI report cards, plans, review narrative)
DEEPSEEK_API_KEY=
AI_DAILY_BUDGET_CNY=5

# Feishu bot (alerts + premarket briefing)
FEISHU_WEBHOOK=

# Email fallback (optional)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_SSL=true
